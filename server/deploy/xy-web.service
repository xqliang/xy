[Unit]
Description=xy game web + api
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/xy/server
Environment=XY_CONFIG=/opt/xy/server/config.yaml
ExecStart=/opt/xy/server/.venv/bin/python /opt/xy/server/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
