{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@core": ["../game-core/src/index.ts"],
      "@asset-manifest": ["./src/asset-manifest.web.ts"]
    }
  },
  "include": ["src", "../game-core/src"]
}
